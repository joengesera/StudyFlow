# Frontend Environment Variables
VITE_API_URL=http://localhost:3000/api

# Web Push VAPID - clé publique du serveur d'abonnement push.
# Générer une paire : `npx web-push generate-vapid-keys`
# La clé privée correspondante est à conserver côté backend pour l'envoi.
VITE_WEB_PUSH_PUBLIC_KEY=

# Synchronise l'abonnement push et les préférences avec le backend (/api/notifications)
VITE_ENABLE_PUSH_BACKEND_SYNC=false